CCC_API_HOST=127.0.0.1
CCC_API_PORT=8001
CCC_DATABASE_URL=sqlite:///./data/cyber_command_center.sqlite3
CCC_LOG_LEVEL=INFO
# Keep authentication enabled for normal LAN/private operation. The setup script
# generates a unique token in .env; never commit or share that file.
CCC_AUTH_ENABLED=true
CCC_API_TOKEN=
CCC_NETWORK_MONITOR_INTERVAL_SECONDS=60
CCC_NETWORK_SCAN_MAX_HOSTS=64
CCC_AUTHORIZED_NETWORK_RANGES=
CCC_AUTHORIZED_SCAN_TARGETS=http://127.0.0.1:8000,http://localhost:8000
CCC_ALERT_HIGH_THRESHOLD=50
CCC_ALERT_CRITICAL_THRESHOLD=75
CCC_AUTH_FAILURE_THRESHOLD=5
CCC_AUTH_FAILURE_WINDOW_MINUTES=10
CCC_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8001,http://localhost:8001
CCC_PAIRING_TTL_SECONDS=300
CCC_HEARTBEAT_INTERVAL_SECONDS=30
CCC_DEVICE_OFFLINE_AFTER_SECONDS=120
CCC_DEVICE_CREDENTIAL_TTL_DAYS=90
# Optional private encrypted tunnel endpoint. Keep blank for LAN-only mode.
CCC_PRIVATE_TUNNEL_ENDPOINT=
# Windows agent runtime values are supplied to the agent process, not the backend.
# CCC_AGENT_URL=http://192.168.1.2:8001
# CCC_AGENT_STATE_DIR=%LOCALAPPDATA%\CyberCommandCenter\agent
# CCC_AGENT_INTERVAL_SECONDS=30
